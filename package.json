{
  "name": "optiontrap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node --watch-path=server/index.js --watch-path=server/db.js --watch-path=server/sessionStore.js --watch-path=server/rateLimit.js --watch-path=server/instruments.js server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch-path=server/index.js --watch-path=server/db.js --watch-path=server/sessionStore.js --watch-path=server/rateLimit.js --watch-path=server/instruments.js server/index.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "http-proxy-middleware": "^3.0.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
