# Kite Connect credentials (NEVER commit this file)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Session encryption key (generate a random 32+ char string)
SESSION_SECRET=change-this-to-a-random-string-at-least-32-chars

# Server port
PORT=3001

# Frontend origin (for CORS in development)
FRONTEND_ORIGIN=http://localhost:3000
